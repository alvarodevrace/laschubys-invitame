{
  "name": "laschubys-invitame",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4322 --no-hmr",
    "start:dev": "ng serve --port 4322 --no-hmr",
    "start:prod": "bun run build:prod && bun run serve:prod",
    "serve:prod": "NODE_ENV=production bun dist/laschubys-invitame/server/server.mjs",
    "build": "NG_BUILD_PARTIAL_SSR=1 CI=1 ng build --configuration production --no-progress",
    "build:dev": "ng build --configuration development",
    "build:prod": "NG_BUILD_PARTIAL_SSR=1 CI=1 ng build --configuration production --no-progress",
    "typecheck": "npx tsc --noEmit",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.10",
    "@ng-icons/core": "^33.2.4",
    "@ng-icons/lucide": "^33.2.4",
    "express": "^5.1.0",
    "motion": "^12.38.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/express": "^5.0.1",
    "@types/node": "^25.9.1",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.60.1"
  }
}
